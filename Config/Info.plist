<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Les serveurs Xtream et leurs images sont souvent en http simple : on l'autorise.
	     Ne pas ajouter NSAllowsArbitraryLoadsForMedia ni ...InWebContent : leur présence fait ignorer NSAllowsArbitraryLoads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Synchronisation par le Wi-Fi avec la TV Android et les autres appareils (découverte automatique). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pour synchroniser la reprise de lecture, les favoris et les listes avec vos autres appareils sur le Wi-Fi de la maison.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_iptvtv._tcp</string>
	</array>
</dict>
</plist>
